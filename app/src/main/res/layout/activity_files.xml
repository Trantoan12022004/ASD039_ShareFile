<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <!-- 1. TOOLBAR (nhúng toolbar đã làm) -->
    <include
        android:id="@+id/layoutToolbar"
        layout="@layout/toolbar_file"
        android:elevation="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- NỘI DUNG CUỘN (SCROLLVIEW) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 2. THANH TÌM KIẾM (SEARCH BAR) -->
            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_bar"
                android:drawableEnd="@drawable/search"
                android:hint="Search file..."
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:fontFamily="@font/outfit_medium"
                android:textColorHint="#66000E00"
                android:textSize="16sp" />

            <!-- 3. KHU VỰC DANH MỤC (CATEGORIES GRID CONTAINER) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_radius_24"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:padding="8dp"
                    tools:ignore="MissingConstraints">

                    <!-- Item 1: Music -->
                    <LinearLayout
                        android:id="@+id/btnMusic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_music" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Music"
                            android:textColor="#000000"
                            android:textSize="14sp" 
                            android:fontFamily="@font/outfit_medium"/>
                    </LinearLayout>

                    <!-- Item 2: Apps -->
                    <LinearLayout
                        android:id="@+id/btnApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_apps" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Apps"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />
                    </LinearLayout>

                    <!-- Item 3: Videos -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_videos" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Videos"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />
                    </LinearLayout>

                    <!-- Item 4: Photos -->
                    <LinearLayout
                        android:id="@+id/btnPhoto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_photos" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Photos"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />
                    </LinearLayout>

                    <!-- Item 5: Document -->
                    <LinearLayout
                        android:id="@+id/btnDocument"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_document" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Document"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />
                    </LinearLayout>

                    <!-- Item 6: PDF -->
                    <LinearLayout
                        android:id="@+id/btnPdf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_pdf" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="PDF"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />
                    </LinearLayout>

                    <!-- Item 7: SafeBox -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_safebox" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="SafeBox"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />
                    </LinearLayout>

                    <!-- Item 8: Download -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_download" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Download"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />
                    </LinearLayout>

                    <!-- Item 9: Zip -->
                    <LinearLayout
                        android:id="@+id/btnZip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_cat_zip" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Zip"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />
                    </LinearLayout>

                </GridLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 4. THẺ DUNG LƯỢNG BỘ NHỚ (STORAGE CARD) -->


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_storage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_radius_24"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgStorageIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_storage_green"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvStorageTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Internal shared storage"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_semibold"
                        app:layout_constraintEnd_toStartOf="@id/layoutScan"
                        app:layout_constraintStart_toEndOf="@id/imgStorageIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ProgressBar
                        android:id="@+id/progressStorage"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="42"
                        android:layout_marginEnd="16dp"
                        android:progressDrawable="@drawable/bg_progress_storage"
                        app:layout_constraintEnd_toStartOf="@id/layoutScan"
                        app:layout_constraintStart_toEndOf="@id/imgStorageIcon"
                        app:layout_constraintTop_toBottomOf="@id/tvStorageTitle" />

                    <TextView
                        android:id="@+id/tvStorageInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:text="21,95 GB/51,48 GB"
                        android:textColor="#99000E00"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium"
                        app:layout_constraintStart_toEndOf="@id/imgStorageIcon"
                        app:layout_constraintTop_toBottomOf="@id/progressStorage" />

                    <!-- Nút Scan bên phải -->
                    <LinearLayout
                        android:id="@+id/layoutScan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan"
                            android:textColor="@color/primary_35"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_medium" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_scan" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 5. THẺ DỌN DẸP CACHE (CLEAN CACHE CARD) -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_radius_24"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgCleanIcon"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:src="@drawable/junk"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnClean"
                        app:layout_constraintStart_toEndOf="@id/imgCleanIcon"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cleaned 18,5 MB"
                            android:textColor="#4E7A0F"
                            android:textSize="16sp"
                            android:fontFamily="@font/outfit_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/outfit_medium"
                            android:text="Used cache storage"
                            android:textColor="#6E7569"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnClean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_16"
                        android:gravity="center"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="12dp"
                        android:text="Clean"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_semibold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>



            <!-- 7. THẺ DANH SÁCH FILE MỚI ĐẾN (RECENTLY ADDED LIST CARD) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_radius_24"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_recent_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="Recently Added"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_semibold"
                    android:textColor="@color/black"
                    android:padding="4dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recent_add"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

                    tools:listitem="@layout/item_file"
                    app:layout_constraintTop_toBottomOf="@+id/tv_recent_add"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>