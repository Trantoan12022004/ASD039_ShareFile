<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    tools:context=".ui.nearby_play.NearbyPlayActivity">

    <include
        android:id="@+id/view_top"
        layout="@layout/tool_nearby_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@id/view_top"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardWoodBase"
            android:layout_width="240dp"
            android:layout_height="215dp"
            android:background="@drawable/ic_wood_base"
            android:padding="6dp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:layout_marginTop="24dp">
            <!-- Khung bọc đĩa Vinyl -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/flVinylContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Lớp 1: Mặt đĩa đen bóng (Dùng vector ellipse_1) -->
                <ImageView
                    android:id="@+id/ivVinylBase"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_elip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <!-- Lớp 2: Rãnh đĩa -->

                <!-- Lớp 3: Tâm đĩa xanh -->
                <ImageView
                    android:id="@+id/ivVinylGrooves"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_vinyl_grooves"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="1.0"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/ivVinylCenterLabel"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_vinyl_center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.28"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.28"
                    tools:ignore="ContentDescription" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Cần kim đĩa (Tonearm) -->
            <ImageView
                android:id="@+id/ivTonearm"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:padding="8dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:scaleType="fitEnd"
                android:src="@drawable/ic_evil_knidle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.75"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.3"
                tools:ignore="ContentDescription" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="@string/nearby_play"
            android:textSize="20sp"
            android:fontFamily="@font/outfit_semibold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/make_sure_both_devices_are_connected_to_the_same_wifi_network"
            android:textColor="@color/sub_title"
            android:fontFamily="@font/outfit_medium" />



        <LinearLayout
            android:id="@+id/btn_nearby_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_radius_24"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:padding="8dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:src="@drawable/ic_radio" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:text="@string/nearby_play"
                    android:fontFamily="@font/outfit_semibold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/play_music_on_a_nearby_device"
                    android:textSize="12sp"
                    android:textColor="#99000E00"
                    android:fontFamily="@font/outfit_medium"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_receive_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_radius_24"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:padding="8dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:src="@drawable/ic_speaker" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:text="@string/receive_music"
                    android:fontFamily="@font/outfit_semibold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/use_this_device_as_a_speaker"
                    android:textSize="12sp"
                    android:textColor="#99000E00"
                    android:fontFamily="@font/outfit_medium"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>