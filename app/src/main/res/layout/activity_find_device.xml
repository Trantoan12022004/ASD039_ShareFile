<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    tools:context=".ui.nearby_play.FindDeviceActivity">

    <include
        android:id="@+id/view_top"
        layout="@layout/tool_nearby_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_top"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="@dimen/_12sdp"
            android:background="@drawable/bg_radius_24"
            android:orientation="vertical">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:src="@drawable/ic_connect"
                android:layout_marginBottom="@dimen/_12sdp"
                android:padding="18dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_12sdp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sub_title"
                    android:text="@string/found"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_medium"/>

                <TextView
                    android:id="@+id/tv_device_count"
                    android:layout_width="13dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:fontFamily="@font/outfit_medium"
                    android:text="3"
                    android:textColor="@color/primary_35"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sub_title"
                    android:text="@string/devices"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_medium"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:hint="@string/enter_ip"
                    android:inputType="phone"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="#000000"
                    android:fontFamily="@font/outfit_medium"
                    android:textColorHint="#66000E00"
                    android:textSize="16sp" />
                
                <TextView
                    android:id="@+id/btn_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/connect"
                    android:textSize="16sp"
                    android:background="@drawable/bg_btn_create"
                    android:paddingVertical="12dp"
                    android:fontFamily="@font/outfit_semibold"
                    android:paddingHorizontal="24dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/btn_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_qr"/>
            </LinearLayout>
        </LinearLayout>
<!--ẩn hiện khi có bài hát được phát-->
        <LinearLayout
            android:id="@+id/layout_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_radius_24"
            android:padding="8dp">
            <TextView
                android:id="@+id/tv_song_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKYLIGHT"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:fontFamily="@font/outfit_semibold"/>

            <TextView
                android:id="@+id/tv_play_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playing on Sony Xperia 10 Mark V"
                android:textColor="@color/primary_35"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_medium"/>

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:padding="0dp"
                android:progressDrawable="@drawable/bg_seekbar_video"
                android:splitTrack="false"
                android:thumb="@null"
                tools:max="100"
                tools:progress="50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_radius_24"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/outfit_medium"
                    tools:text="08:54" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_radius_24"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/outfit_medium"
                    tools:text="08:55" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:gravity="start">
                    <ImageView
                        android:id="@+id/btn_quit_playing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_quit"/>
                </LinearLayout>




                <LinearLayout
                    android:id="@+id/layoutCenterControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/btnPrevious"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/btn_prev2" />

                    <ImageView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="8dp"
                        android:src="@drawable/btn_pause2" />

                    <ImageView
                        android:id="@+id/btnNext"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/btn_next2"/>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_songs"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:clipToPadding="false"
                android:visibility="visible"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_nearby_play" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="@string/available_devices"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/outfit_semibold"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/item_device" />

        <ProgressBar
            android:id="@+id/pb_searching"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/primary_35" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>