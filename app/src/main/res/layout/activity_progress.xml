<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    tools:context=".ui.transfer.progress.ProgressActivity">

    <!-- Top Toolbar: Tên thiết bị, dung lượng tổng, thời gian -->
    <include
        android:id="@+id/view_top"
        layout="@layout/toolbar_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Banner trạng thái Online / Offline nổi dưới Toolbar -->
    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_radius_16"
        android:backgroundTint="#80000000"
        android:fontFamily="@font/outfit_medium"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp"
        android:text="@string/status_online"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_top"
        tools:text="Sony Xperia 5 Mark IV online"
        tools:visibility="visible" />

    <!-- Danh sách Chat & Tiến trình truyền file -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatProgress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/view_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_top"
        app:stackFromEnd="true"
        tools:itemCount="5"
        tools:listitem="@layout/item_progress_send" />

    <!-- Bottom Input Bar: Nút Add file, Ô nhập text, Nút gửi -->
    <LinearLayout
        android:id="@+id/view_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_music_play"
        android:orientation="horizontal"
        android:padding="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btn_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/btn_add1" />

        <EditText
            android:id="@+id/et_send"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:fontFamily="@font/outfit_medium"
            android:hint="@string/enter_message"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#66000E00"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/btn_send1" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
