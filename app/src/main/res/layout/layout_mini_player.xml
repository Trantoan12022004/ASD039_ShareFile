<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mini_player"
    android:paddingBottom="12dp">

    <!-- 1. Thanh Progress Bar chạy sát trên đỉnh -->
    <ProgressBar
        android:id="@+id/progress_song"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="80"
        android:progressDrawable="@drawable/bg_progress_bar_purple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Ảnh Album hình tròn bên trái -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_album_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_song"
        app:shapeAppearanceOverlay="@style/CircleImage"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- 3. Tên bài hát -->
    <TextView
        android:id="@+id/tv_song_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="dashstar*"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tv_artist_name"
        app:layout_constraintEnd_toStartOf="@+id/btn_play_pause"
        app:layout_constraintStart_toEndOf="@+id/iv_album_art"
        app:layout_constraintTop_toTopOf="@+id/iv_album_art"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- 4. Tên ca sĩ -->
    <TextView
        android:id="@+id/tv_artist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Knock2"
        android:textColor="#A595B5"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_album_art"
        app:layout_constraintEnd_toEndOf="@+id/tv_song_title"
        app:layout_constraintStart_toStartOf="@+id/tv_song_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_song_title" />

    <!-- 5. Nút Play/Pause hình tròn -->
    <ImageView
        android:id="@+id/btn_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_btn_circle"
        android:padding="13dp"
        android:src="@drawable/pause"
        app:layout_constraintBottom_toBottomOf="@+id/iv_album_art"
        app:layout_constraintEnd_toStartOf="@+id/btn_playlist"
        app:layout_constraintTop_toTopOf="@+id/iv_album_art"
        app:tint="@color/white" />

    <!-- 6. Nút Danh sách phát / Queue hình tròn -->
    <ImageView
        android:id="@+id/btn_playlist"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_btn_circle"
        android:padding="13dp"
        android:src="@drawable/queue_music"
        app:layout_constraintBottom_toBottomOf="@+id/iv_album_art"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_album_art"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>