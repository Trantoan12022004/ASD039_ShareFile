<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/_12sdp"
        android:paddingHorizontal="@dimen/_6sdp">

        <ImageView
            android:id="@+id/iv_left"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_btn_circle"
            android:padding="@dimen/_8sdp"
            android:visibility="gone"
            android:src="@drawable/chevron_left" />

        <TextView
            android:id="@+id/tv_tool_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_toStartOf="@+id/iv_right1"
            android:layout_toEndOf="@+id/iv_left"
            android:ellipsize="end"
            android:fontFamily="@font/clashdisplay_semibold"
            android:gravity="start"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/_18ssp" />

        <ImageView
            android:id="@+id/iv_right1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_circle"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/iv_right"
            android:padding="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:src="@drawable/search" />

        <ImageView
            android:id="@+id/iv_right"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_circle"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:src="@drawable/settings" />
    </RelativeLayout>

</RelativeLayout>