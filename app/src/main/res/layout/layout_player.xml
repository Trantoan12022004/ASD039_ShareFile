<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ========================================== -->
    <!-- 2. KHU VỰC EXPANDED PLAYER                  -->
    <!-- ========================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_expand_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_default_player_expand"
        android:padding="@dimen/_20sdp"
        android:visibility="visible"
        android:alpha="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    <!-- Tên bài hát (Expanded) -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:fontFamily="@font/plusjakartasans_bold"
        android:maxLines="1"
        android:text="SPITFIRE"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tên ca sĩ (Expanded) -->
    <TextView
        android:id="@+id/tv_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/plusjakartasans_regular"
        android:maxLines="1"
        android:text="Skrillex &amp; Hawaii Slim"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <!-- Thanh SeekBar thời gian -->
    <SeekBar
        android:id="@+id/seekbar_music"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="100"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_bar_purple"
        android:thumbTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_artist" />

    <!-- Thời gian hiện tại -->
    <TextView
        android:id="@+id/tv_current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_time_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="00:00"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekbar_music" />

    <!-- Tổng thời gian -->
    <TextView
        android:id="@+id/tv_total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_time_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="00:00"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_current_time" />

    <!-- Nút Play/Pause chính & Hiệu ứng Glassy -->
    <com.example.basekotlin.util.GlassyCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cornerRadius="24dp"
        app:glassBackground="#14D4D4D4"
        app:layout_constraintBottom_toBottomOf="@id/btn_play_pause"
        app:layout_constraintEnd_toEndOf="@id/btn_play_pause"
        app:layout_constraintStart_toStartOf="@id/btn_play_pause"
        app:layout_constraintTop_toTopOf="@id/btn_play_pause" />

        <ImageView
            android:id="@+id/btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="13dp"
            android:elevation="4dp"
            android:src="@drawable/pause_liquid"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_current_time" />

    <!-- Nút Previous & Hiệu ứng Glassy -->
    <com.example.basekotlin.util.GlassyCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cornerRadius="24dp"
        app:glassBackground="#14D4D4D4"
        app:layout_constraintBottom_toBottomOf="@id/btn_prev"
        app:layout_constraintEnd_toEndOf="@id/btn_prev"
        app:layout_constraintStart_toStartOf="@id/btn_prev"
        app:layout_constraintTop_toTopOf="@id/btn_prev" />

    <ImageView
        android:id="@+id/btn_prev"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/skip_previous_liquid"
        app:layout_constraintBottom_toBottomOf="@+id/btn_play_pause"
        app:layout_constraintEnd_toStartOf="@+id/btn_play_pause"
        app:layout_constraintTop_toTopOf="@+id/btn_play_pause" />

    <!-- Nút Next & Hiệu ứng Glassy -->
    <com.example.basekotlin.util.GlassyCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cornerRadius="24dp"
        app:glassBackground="#14D4D4D4"
        app:layout_constraintBottom_toBottomOf="@id/btn_next"
        app:layout_constraintEnd_toEndOf="@id/btn_next"
        app:layout_constraintStart_toStartOf="@id/btn_next"
        app:layout_constraintTop_toTopOf="@id/btn_next" />

    <ImageView
        android:id="@+id/btn_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/next_liquid"
        app:layout_constraintBottom_toBottomOf="@+id/btn_play_pause"
        app:layout_constraintStart_toEndOf="@+id/btn_play_pause"
        app:layout_constraintTop_toTopOf="@+id/btn_play_pause"
         />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini_player"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:paddingBottom="12dp"
        android:visibility="visible"
        android:alpha="1"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginTop="0dp"
        app:layout_goneMarginBottom="0dp">

        <!-- Progress Bar chạy sát trên đỉnh -->
        <ProgressBar
            android:id="@+id/progress_song"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/bg_progress_bar_purple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ảnh Album hình tròn bên trái -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_album_art"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progress_song"
            app:shapeAppearanceOverlay="@style/CircleImage"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Tên bài hát (Mini) -->
        <TextView
            android:id="@+id/tv_song_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="dashstar*"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tv_artist_name"
            app:layout_constraintEnd_toStartOf="@+id/btn_mini_play_pause"
            app:layout_constraintStart_toEndOf="@+id/iv_album_art"
            app:layout_constraintTop_toTopOf="@+id/iv_album_art"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Tên ca sĩ (Mini) -->
        <TextView
            android:id="@+id/tv_artist_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Knock2"
            android:textColor="#A595B5"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_album_art"
            app:layout_constraintEnd_toEndOf="@+id/tv_song_title"
            app:layout_constraintStart_toStartOf="@+id/tv_song_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_song_title" />

        <!-- Nút Play/Pause Mini -->
        <ImageView
            android:id="@+id/btn_mini_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_circle"
            android:src="@drawable/pause_liquid"
            app:layout_constraintBottom_toBottomOf="@+id/iv_album_art"
            app:layout_constraintEnd_toStartOf="@+id/btn_playlist"
            app:layout_constraintTop_toTopOf="@+id/iv_album_art" />

        <!-- Nút Queue/Playlist -->
        <ImageView
            android:id="@+id/btn_playlist"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_btn_circle"
            android:padding="13dp"
            android:src="@drawable/queue_music"
            app:layout_constraintBottom_toBottomOf="@+id/iv_album_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_album_art"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>