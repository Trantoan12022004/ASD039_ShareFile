<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <!-- Toolbar trên cùng kế thừa tool_bar dùng chung -->
    <include
        android:id="@+id/view_top"
        layout="@layout/tool_safe_box" />

    <!-- Icon khóa SafeBox -->
    <ImageView
        android:id="@+id/iv_lock_header"
        android:layout_width="@dimen/_54sdp"
        android:layout_height="@dimen/_54sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:contentDescription="@string/safe_box"
        android:src="@drawable/ic_safe_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_top" />

    <!-- Dòng hướng dẫn (Hint / Error text) -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/outfit_medium"
        android:gravity="center"
        android:text="@string/draw_pattern_to_lock"
        android:textColor="@color/black"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_lock_header" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:fontFamily="@font/outfit_medium"
        android:gravity="center"
        android:text="@string/draw_pattern_to_lock"
        android:textColor="#99000E00"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <!-- PatternLockView hình vuông tỉ lệ 1:1 căn giữa màn hình -->
    <com.example.basekotlin.ui.safebox.lock.PatternLockView
        android:id="@+id/pattern_lock_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_28sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:background="@drawable/bg_radius_24"
        app:layout_constraintBottom_toTopOf="@id/btn_redraw"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_desc"
        app:layout_constraintVertical_bias="0.4" />

    <!-- Nút Redraw cho phép vẽ lại khi lỗi hoặc xác nhận -->
    <LinearLayout
        android:id="@+id/btn_redraw"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="@dimen/_32sdp"
        android:background="@drawable/bg_btn_16"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_18sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:src="@drawable/lock_reset"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_medium"
            android:text="@string/redraw"
            android:textColor="@color/white"
            android:textSize="@dimen/_13ssp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
