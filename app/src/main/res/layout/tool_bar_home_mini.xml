<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tool_bar"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Cụm 3 nút chức năng bên trái: Send, Receive, Files -->
    <LinearLayout
        android:id="@+id/layoutLeftActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Send Button -->
        <LinearLayout
            android:id="@+id/layoutSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="Send"
                android:elevation="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />

            <TextView
                android:id="@+id/tvSendLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit_semibold"
                android:text="@string/send"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Receive Button -->
        <LinearLayout
            android:id="@+id/layoutReceive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnReceive"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="Receive"
                android:elevation="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_receive" />

            <TextView
                android:id="@+id/tvReceiveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit_semibold"
                android:text="@string/receive"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Files Button -->
        <LinearLayout
            android:id="@+id/layoutFiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnFiles"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="Files"
                android:elevation="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_file" />

            <TextView
                android:id="@+id/tvFilesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit_semibold"
                android:text="@string/files"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Nút Icon góc phải: Notification & History -->
    <LinearLayout
        android:id="@+id/layoutHeaderActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/layoutLeftActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layoutLeftActions">

        <!-- Notification Bell Icon -->
        <ImageView
            android:id="@+id/btnNotification"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Notification"
            android:elevation="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_noti" />

        <!-- History/Receive Status Icon -->
        <ImageView
            android:id="@+id/btnSync"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="History"
            android:elevation="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>