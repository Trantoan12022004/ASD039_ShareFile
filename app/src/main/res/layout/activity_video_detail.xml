<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. PlayerView Media3 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:use_controller="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Lớp đón cử chỉ chạm (Touch Overlay) -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4. Feedback tua nhanh (Double tap feedback) -->
    <TextView
        android:id="@+id/tvFeedbackOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_btn_16"
        android:backgroundTint="#99000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutCenterControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 5. Nút Unlock khi bật chế độ khóa -->
    <ImageView
        android:id="@+id/btnUnlock"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_lock"
        android:layout_marginBottom="@dimen/_12sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/layoutBottomControls"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomControls" />

    <!-- 6. HEADER LAYOUT -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_12sdp"
        android:background="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/btn_back" />

        <com.example.basekotlin.util.AlwaysMarqueeTextView
            android:id="@+id/tvVideoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/anton_regular"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="22sp"
            tools:text="Video_Sample.mp4" />

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/btn_send" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/btn_more" />
    </LinearLayout>

    <!-- 7. MAIN PLAYBACK CONTROLS (Center) -->
    <LinearLayout
        android:id="@+id/layoutCenterControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnPrevious"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/btn_prev1" />

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="8dp"
            android:src="@drawable/btn_pause1" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/btn_next1"/>
    </LinearLayout>

    <!-- Lock -->
        <ImageView
            android:id="@+id/btnLock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_lock"
            android:layout_marginBottom="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="@+id/layoutBottomControls"
            app:layout_constraintBottom_toTopOf="@+id/layoutBottomControls" />

    <!-- 8. BOTTOM CONTROLS LAYOUT -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_16_regular"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_margin="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <SeekBar
            android:id="@+id/seekBarVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:max="100"
            tools:progress="50"
            android:progressTint="@color/primary_40"
            android:thumbTint="@color/primary_40" />

        <!-- SeekBar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_16"
                android:backgroundTint="#A3F2FFE2"
                android:fontFamily="@font/outfit_medium"
                android:padding="4dp"
                android:text="00:00"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_16"
                android:backgroundTint="#A3F2FFE2"
                android:fontFamily="@font/outfit_regular"
                android:padding="4dp"
                android:text="00:00"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 8 Action Buttons Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <!-- Speed -->
            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_semibold"
                android:gravity="center"
                android:text="1.0x"
                android:background="@drawable/bg_glass_16_clear"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="8dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnVolume"/>


            <!-- Volume -->
            <ImageView
                android:id="@+id/btnVolume"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_100_clear"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_volume_up"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btnSpeed"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- Ratio -->
            <ImageView
                android:id="@+id/btnAspectRatio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_100_clear"
                android:src="@drawable/aspect_ratio"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnOrientation"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Rotate -->
            <ImageView
                android:id="@+id/btnOrientation"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_100_clear"
                android:src="@drawable/crop_rotate"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnPlayQueue"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Queue -->
            <ImageView
                android:id="@+id/btnPlayQueue"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_100_clear"
                android:src="@drawable/playlist_play"
                app:layout_constraintEnd_toStartOf="@id/btnPip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- PiP -->

            <ImageView
                android:id="@+id/btnPip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/bg_glass_100_clear"
                android:src="@drawable/ic_pip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
