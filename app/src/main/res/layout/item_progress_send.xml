<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="36dp"
        android:background="@drawable/bg_radius_24"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgThumbnail"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_radius_16"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/avatars" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Tên File -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_semibold"
                    android:maxLines="1"
                    android:text="VID_20222021"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <!-- dung lượng file đã gửi thành công  -->
                <TextView
                    android:id="@+id/tvSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:text="5,5 MB"
                    android:textColor="#6E7569"
                    android:textSize="12sp" />

                <!-- tiến trình gửi file  -->
                <TextView
                    android:id="@+id/tv_size_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:text="2,2 MB/3,3 MB"
                    android:textColor="@color/primary_35"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- có ba trạng thái lỗi: Canceled, Error, Declined -->
                <TextView
                    android:id="@+id/tv_status_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:text="Canceled"
                    android:textColor="#D71818"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Có ba trạng thái (thành công: ic_done, đang send: ic_cancel, bị Canceled, Error, Declined: ic_refresh) -->
            <ImageView
                android:id="@+id/iv_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_done" />

            <ImageView
                android:id="@+id/iv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_cancel"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_refresh"
                android:visibility="gone" />
        </LinearLayout>

        <!-- cập nhật tiến trình ẩn khi nhận thành công -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:padding="0dp"
            android:progressDrawable="@drawable/bg_seekbar_video"
            android:splitTrack="false"
            android:thumb="@null"
            tools:max="100"
            tools:progress="50" />

    </LinearLayout>

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_user" />

</LinearLayout>