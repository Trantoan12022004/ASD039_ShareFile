<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:background="@drawable/bg_card_white_rounded"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/anton_regular"
            android:text="@string/join_group"
            android:textColor="@color/black"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/outfit_medium"
            android:text="@string/select_how_to"
            android:textColor="#6E7569"
            android:textSize="14sp" />

        <!-- Nút Quét QR Code -->
        <LinearLayout
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_radius_16"
            android:backgroundTint="#FAFAF7"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_radius_14"
                android:backgroundTint="#F2F9E8"
                android:contentDescription="@string/scan_qr_code"
                android:padding="10dp"
                android:src="@drawable/ic_qr_code_scan"
                app:tint="@color/primary_40" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:text="@string/scan_qr_code"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit_medium"
                    android:text="@string/scan_qr_desc"
                    android:textColor="#6E7569"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nút Nhập IP Thủ Công -->
        <LinearLayout
            android:id="@+id/btnEnterIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_radius_16"
            android:backgroundTint="#FAFAF7"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_radius_14"
                android:backgroundTint="#F2F9E8"
                android:contentDescription="@string/enter_ip_address"
                android:padding="10dp"
                android:src="@drawable/send"
                app:tint="@color/primary_40" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:text="@string/enter_ip_address"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit_medium"
                    android:text="@string/enter_ip_desc"
                    android:textColor="#6E7569"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_cancel"
            android:fontFamily="@font/outfit_semibold"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="@string/cancel"
            android:textColor="@color/black"
            android:textSize="16sp" />

    </LinearLayout>
</RelativeLayout>
