<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/_12sdp">

    <!-- Thanh Nền Bo Tròn Hình Viên Thuốc (Capsule Bar) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_navigation"
        android:elevation="4dp"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Nút bên trái: Home (Chữ + Icon) -->
        <LinearLayout
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/viewCenterGuide"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_semibold"
                android:text="@string/home"
                android:textColor="#000000"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/imgHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_home" />
        </LinearLayout>

        <!-- Guide View để chừa khoảng trống giữa cho nút (+) -->
        <View
            android:id="@+id/viewCenterGuide"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Nút bên phải: Scan (Icon + Chữ) -->
        <LinearLayout
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewCenterGuide">

            <ImageView
                android:id="@+id/imgScan"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Scan"
                android:src="@drawable/ic_qr_code_scan" />

            <TextView
                android:id="@+id/tvScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_semibold"
                android:text="@string/scan"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Nút Nổi Tròn Nổi Nổi Ở Giữa (+) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:contentDescription="Add"
        app:backgroundTint="@color/primary_35"
        app:elevation="6dp"
        app:fabCustomSize="64dp"
        app:layout_constraintBottom_toBottomOf="@id/layoutBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/layoutBar"
        app:maxImageSize="32dp"
        app:tint="@color/white"
        app:srcCompat="@drawable/ic_add"/>

</androidx.constraintlayout.widget.ConstraintLayout>