<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="6dp"
        android:padding="16dp"
        android:background="@drawable/bg_tool_bar"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/view_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">
            <!-- Nút Back bên trái -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Tiêu đề "Files" -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/anton_regular"
                android:text="@string/files"
                android:textColor="#0A1207"
                android:textSize="22sp"
                app:layout_constraintStart_toEndOf="@id/btnBack" />
        </LinearLayout>


        <!-- Card Header: Junk Memory Card -->
        <LinearLayout
            android:id="@+id/cardJunkHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_radius_24"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/view_top">

            <ImageView
                android:id="@+id/imgJunkIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/junk"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgJunkIcon">

                <TextView
                    android:id="@+id/tvJunkSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_semibold"
                    android:text="0.0 MB"
                    android:textColor="@color/black"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/tvJunkDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit_medium"
                    android:text="@string/junk_files_cleaned"
                    android:textColor="#6E7569"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCleanUpMore"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_16"
                    android:fontFamily="@font/outfit_semibold"
                    android:paddingHorizontal="18dp"
                    android:text="@string/clean_up_more"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_24sdp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="horizontal"
                android:background="@drawable/bg_radius_24"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_delete_sweep"/>

                <com.example.basekotlin.util.AlwaysMarqueeTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/outfit_medium"
                    android:text="@string/cleanup_more"
                    android:textColor="#CC000E00"
                    android:textSize="14sp" />
            </LinearLayout>
            <!-- Tiêu đề System Cleaners -->
            <TextView
                android:id="@+id/tvSystemCleanersTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:fontFamily="@font/outfit_semibold"
                android:text="@string/system_cleaners"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <!-- Grid 6 Items System Cleaners -->
            <!-- Hàng 1: Apps Cleanup + Big Files -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <!-- 1. Apps Cleanup -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAppsCleanup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_radius_24"
                    android:elevation="2dp"
                    
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/imgApps"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_cat_apps"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAppsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_semibold"
                        android:maxLines="1"
                        android:gravity="center"
                        android:text="@string/apps_cleanup"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgApps" />

                    <TextView
                        android:id="@+id/tvAppsDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_medium"
                        android:maxLines="1"
                        android:gravity="center"
                        android:text="@string/apps_cleanup_desc"
                        android:textColor="#6E7569"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvAppsTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 2. Big Files -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardBigFiles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_radius_24"
                    android:elevation="2dp"
                    
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/imgBigFiles"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_clean_big_files"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvBigFilesTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_semibold"
                        android:maxLines="1"
                        android:gravity="center"
                        android:text="@string/big_files"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgBigFiles" />

                    <TextView
                        android:id="@+id/tvBigFilesDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:fontFamily="@font/outfit_medium"
                        android:maxLines="1"
                        android:text="@string/big_files_desc"
                        android:textColor="#6E7569"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvBigFilesTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- Hàng 2: Video Cleanup + Photo Cleanup -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <!-- 3. Video Cleanup -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardVideoCleanup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_radius_24"
                    android:elevation="2dp"
                    
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/imgVideo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_cat_videos"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvVideoTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/video_cleanup"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgVideo" />

                    <TextView
                        android:id="@+id/tvVideoDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/video_cleanup_desc"
                        android:textColor="#6E7569"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvVideoTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 4. Photo Cleanup -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardPhotoCleanup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_radius_24"
                    android:elevation="2dp"
                    
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/imgPhoto"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_cat_photos"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPhotoTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/photo_cleanup"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgPhoto" />

                    <TextView
                        android:id="@+id/tvPhotoDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/photo_cleanup_desc"
                        android:textColor="#6E7569"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPhotoTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- Hàng 3: Audio Cleanup + Duplicate Files -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <!-- 5. Audio Cleanup -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAudioCleanup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_radius_24"
                    android:elevation="2dp"
                    
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/imgAudio"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_cat_music"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAudioTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/audio_cleanup"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgAudio" />

                    <TextView
                        android:id="@+id/tvAudioDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/audio_cleanup_desc"
                        android:textColor="#6E7569"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvAudioTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 6. Duplicate Files -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardDuplicateFiles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_radius_24"
                    android:elevation="2dp"
                    
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/imgDuplicate"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_clean_duplicate"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDuplicateTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/duplicate_files"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgDuplicate" />

                    <TextView
                        android:id="@+id/tvDuplicateDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/duplicate_files_desc"
                        android:textColor="#6E7569"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvDuplicateTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- Tiêu đề Messenger Cleaners -->
            <TextView
                android:id="@+id/tvMessengerCleanersTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:fontFamily="@font/outfit_semibold"
                android:text="@string/messenger_cleaners"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <!-- Telegram Cleaner Item -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardTelegramCleaner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/bg_radius_24"
                android:elevation="2dp"
                
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:id="@+id/imgTelegram"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_clean_telegram"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvTelegramStatus"
                    app:layout_constraintStart_toEndOf="@id/imgTelegram"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvTelegramTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semibold"
                        android:text="@string/telegram_cleaner"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTelegramDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/outfit_medium"
                        android:text="@string/messenger_cleaner_desc"
                        android:textColor="#6E7569"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTelegramStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/outfit_semibold"
                    android:textColor="@color/primary_35"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icArrowTelegram"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/icArrowTelegram"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    android:src="@drawable/keyboard_arrow_right"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- WhatsApp Cleaner Item -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardWhatsappCleaner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/bg_radius_24"
                android:elevation="2dp"
                
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:id="@+id/imgWhatsapp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_clean_whatsapp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvWhatsappStatus"
                    app:layout_constraintStart_toEndOf="@id/imgWhatsapp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvWhatsappTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semibold"
                        android:text="@string/whatsapp_cleaner"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvWhatsappDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/outfit_medium"
                        android:text="@string/messenger_cleaner_desc"
                        android:textColor="#6E7569"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvWhatsappStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/outfit_semibold"
                    android:textColor="@color/primary_35"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icArrowWhatsapp"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/icArrowWhatsapp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    android:src="@drawable/keyboard_arrow_right"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
