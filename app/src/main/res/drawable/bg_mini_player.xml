<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Nền tím đen quyến rũ -->
    <gradient
        android:angle="270"
        android:startColor="#F5280030"
        android:centerColor="#FF120815"
        android:endColor="#F5280030"
        android:type="linear" />
    <!-- Bo tròn góc card -->
    <corners android:radius="20dp" />
    <!-- Viền mỏng bao ngoài -->
    <stroke
        android:width="1dp"
        android:color="#281438" />
</shape>