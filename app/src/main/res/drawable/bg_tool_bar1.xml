<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lớp bóng đổ bên dưới (Shadow Layer) -->
    <item
        android:top="4dp"
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <!-- Màu bóng đổ mờ đen -->
            <solid android:color="#20000000" />
            <corners
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="26dp" />
        </shape>
    </item>

    <!-- Lớp nền chính đè lên trên (Main Content Layer) -->
    <item
        android:top="0dp"
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_99" />
<!--            <corners-->
<!--                android:bottomLeftRadius="24dp"-->
<!--                android:bottomRightRadius="24dp" />-->
        </shape>
    </item>

</layer-list>