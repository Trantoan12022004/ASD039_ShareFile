<?xml version="1.0" encoding="utf-8"?>
<!-- Track (nền dài) của AppSwitch — khớp 3D_Switch.png: xanh cyan khi bật, xám khi tắt -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#6718DD" />
            <corners android:radius="16dp" />
            <size android:height="28dp" android:width="52dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8A8A8E" />
            <corners android:radius="16dp" />
            <size android:height="28dp" android:width="52dp" />
        </shape>
    </item>

</selector>